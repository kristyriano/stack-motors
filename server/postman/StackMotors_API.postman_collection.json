        {
          "name": "Register user (Kristy)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kristy Riano\",\n  \"email\": \"{{emailA}}\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = Date.now();",
                  "pm.collectionVariables.set('emailA', `kristy.${t}@stackmotors.test`);",
                  "pm.collectionVariables.set('emailB', `shuai.${t}@stackmotors.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Signed up message', () => pm.expect(pm.response.json().message).to.include('signed up'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate email (error)",
